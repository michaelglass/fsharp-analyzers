<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <WarnOn>3390;1104;0020;0044;0025;3391;0067;0021;1182</WarnOn>
    <NoWarn>$(NoWarn);NU1605;NU1608;MSB3277;NETSDK1188</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAnalyzersToOutput</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>MichaelGlass.FSharp.Analyzers</PackageId>
    <Version>0.1.0-alpha.4</Version>
    <Authors>Michael Glass</Authors>
    <Description>F# analyzers for common pitfalls: wildcard matches, ignored Tasks, raw SQL, missing error reporting, restricted calls</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/michaelglass/fsharp-analyzers</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!--
    Packages the analyzer HOST (FSharp.Analyzers.SDK / the fshw daemon) already loads.
    These must NOT be bundled or they collide with the host's own copies. Everything
    else among our runtime deps (i.e. the editorconfig transitive closure) MUST ship,
    or EditorConfigParser() throws FileNotFoundException at construction inside the host
    and every .editorconfig MGA key silently falls back to its hardcoded default.
    Listing only the host-provided set (a stable contract) — rather than the volatile
    editorconfig closure — means a future editorconfig bump auto-bundles new transitive
    deps instead of silently dropping them.
  -->
  <ItemGroup>
    <_AnalyzerHostProvidedPackage Include="FSharp.Analyzers.SDK" />
    <_AnalyzerHostProvidedPackage Include="FSharp.Compiler.Service" />
    <_AnalyzerHostProvidedPackage Include="FSharp.Core" />
    <_AnalyzerHostProvidedPackage Include="McMaster.NETCore.Plugins" />
    <_AnalyzerHostProvidedPackage Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Build-time only (SourceLink, PrivateAssets=All); never a runtime analyzer dep. -->
    <_AnalyzerHostProvidedPackage Include="System.IO.Hashing" />
  </ItemGroup>

  <Target Name="_AddAnalyzersToOutput" DependsOnTargets="ResolveReferences">
    <!-- Materialise the host list into a ';'-bracketed property: item-list refs (@(...))
         do NOT expand inside property-function arguments, only in a plain assignment. -->
    <PropertyGroup>
      <_AnalyzerHostProvidedList>;@(_AnalyzerHostProvidedPackage);</_AnalyzerHostProvidedList>
    </PropertyGroup>
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutputPath)/$(AssemblyName).dll" PackagePath="analyzers/dotnet/fs" />
      <TfmSpecificPackageFile Include="$(OutputPath)/$(AssemblyName).pdb" PackagePath="analyzers/dotnet/fs" />

      <!-- Bundle every runtime dependency that the host does NOT already provide.
           Substring match against ';'-bracketed sentinels so package ids that are
           prefixes of one another can't false-match. -->
      <_AnalyzerBundledDll
        Include="@(RuntimeCopyLocalItems)"
        Condition="'%(RuntimeCopyLocalItems.Extension)' == '.dll'
                   and !$(_AnalyzerHostProvidedList.Contains(';%(RuntimeCopyLocalItems.NuGetPackageId);'))" />
      <TfmSpecificPackageFile Include="@(_AnalyzerBundledDll)" PackagePath="analyzers/dotnet/fs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Compile Include="EditorConfig.fs" />
    <Compile Include="Suppression.fs" />
    <Compile Include="AstWalk.fs" />
    <Compile Include="WildcardAnalyzer.fs" />
    <Compile Include="TaskIgnoreAnalyzer.fs" />
    <Compile Include="RawSqlAnalyzer.fs" />
    <Compile Include="ErrorReportingAnalyzer.fs" />
    <Compile Include="RestrictedCallAnalyzer.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Analyzers.SDK" Version="0.37.2" />
    <PackageReference Include="editorconfig" Version="0.16.2" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" />
  </ItemGroup>

</Project>
